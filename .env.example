# ============ AI 题库生成 API（OpenAI/DeepSeek/通义千问 兼容格式）============
# 1. 填写你的 API Base URL（以 /v1 结尾）
# 2. 填写你的 API Key
VITE_AI_API_BASE_URL=https://api.deepseek.com/v1
VITE_AI_API_KEY=your-api-key-here

# ============ 腾讯云 CloudBase 云数据库（题库共享）============
# 1. 在 https://cloud.tencent.com/product/tcb 开通 CloudBase 环境
# 2. 在环境设置中拿到「环境 ID」
# 3. 填到这里，即可让所有访问者共享同一份题库
VITE_CLOUDBASE_ENV_ID=your-cloudbase-env-id
