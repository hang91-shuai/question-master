# ============ AI 题库生成 API（OpenAI/DeepSeek/通义千问 兼容格式）============
# 1. 填写你的 API Base URL（以 /v1 结尾）
# 2. 填写你的 API Key
VITE_AI_API_BASE_URL=https://api.deepseek.com/v1
VITE_AI_API_KEY=your-api-key-here

# ============ 腾讯云 CloudBase 新版 PostgreSQL 云数据库（题库共享）============
# 1. 在 CloudBase 控制台 → 环境管理 → API Key 配置 → 生成「客户端 Publishable Key」
# 2. 环境 URL 格式：https://{你的环境ID}.api.tcloudbasegateway.com/v1/rdb/rest
# 3. 在数据库中创建表 question_banks，开启 RLS，并配置 Policy（anon 可读，anonymous 可写）
VITE_CLOUDBASE_URL=https://your-env-id.api.tcloudbasegateway.com/v1/rdb/rest
VITE_CLOUDBASE_ANON_KEY=your-publishable-key-here
