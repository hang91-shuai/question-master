# ============ AI 题库生成 API（OpenAI/DeepSeek/通义千问 兼容格式）============
# 1. 填写你的 API Base URL（以 /v1 结尾）
# 2. 填写你的 API Key
VITE_AI_API_BASE_URL=https://api.deepseek.com/v1
VITE_AI_API_KEY=your-api-key-here

# ============ 腾讯云 CloudBase 云端题库共享（通过 HTTP 云函数代理）============
# 为绕开浏览器 CORS，前端统一请求一个 HTTP 云函数，云函数在服务端转发到数据库 API。
# 1. 在项目中创建 HTTP 云函数 question-sync（见 functions/question-sync），并部署为 HTTP 访问路径 /api
# 2. 填下面的云函数 HTTP 地址（{访问服务域名}/api），例如：
#    https://{环境ID}-{数字}.ap-shanghai.app.tcloudbase.com/api
VITE_CLOUDBASE_PROXY_URL=https://your-env-id.ap-shanghai.app.tcloudbase.com/api
